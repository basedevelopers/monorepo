{
  "name": "monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf .turbo node_modules bun.lockb",
    "check": "taze major -r",
    "bump": "taze major -rwi"
  },
  "engines": {
    "node": ">= 22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.1",
    "jsr": "^0.14.3",
    "taze": "^21.1.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "bun@1.4.2"
}
